tools/node_modules/
tools/_preview.pptx
~$*

# video: installed packages, prepared media, renders and generated data are rebuilt by the scripts
video/node_modules/
video/public/
video/out/
video/src/generated/

# large media belongs on Google Drive, not in git
*.mp4
*.mov
*.wav
*.mp3
01_Video_Pitch/generated/
__pycache__/

# local tools installed for voice work (uv, Python environment)
tools/.bin/
tools/voice/.venv/

# the film (film/) is a web page that needs its own sound to play, and its draft render is kept for review
!film/voice/*.wav
!film/sfx/*
!film/music/*.wav
!assets/music/*.mp3
!film/film_draft.mp4
film/_shots/

# voice takes being tried out; only checked takes copied into film/voice/ are kept
film/voice_new/
film/voice_takes/
